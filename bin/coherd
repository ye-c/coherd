#!/usr/bin/env bash
# coherd — 从零拉起 herdr 多 agent 协作集群
#
# 用法: coherd [init] [REPO] [LABEL]
#   init  强制(重)建: 该 label 的 workspace 已存在则先关闭再走正常创建; 不存在则等价普通创建
#   REPO  目标仓库目录 (默认 $PWD)
#   LABEL workspace 标签   (默认 repo basename)
#
# 角色:  coordinator 协调 (可与 reviewer 讨论) / executor 执行 / reviewer 审查
#   三角色均为「槽位」, 具体 agent CLI 由配置决定, 本脚本不绑定任何特定 CLI:
#     COHERD_COORDINATOR_CMD / COHERD_EXECUTOR_CMD / COHERD_REVIEWER_CMD
#     未设置时回退 PATH 中的 pi / omp / cc; 均缺则 die 指向 docs/configuration.md
#   agent 私有配置 (env/flag/wrapper 内容) 由用户自备, 本脚本不注入不修改
#
# 布局:  默认横屏; 需竖屏时传 -p/--portrait (无赋值 flag)。不做几何自动检测
#   (headless 场景拿不到真实屏幕, 自动判横竖不可靠)
#   竖屏: coordinator 上 / reviewer 中 / executor 下 (均分三行)
#   横屏: reviewer 左上 / executor 右上 / coordinator 下全宽
#
# 幂等:  按 workspace label 查重, 已存在则聚焦后退出 (不重建); init 子命令除外: 先 close 再重建
# 失败:  set -euo pipefail, ERR 时提示 workspace_id 供手动清理
# 依赖:  herdr, jq; 兼容 bash 3.2 (不用 bash4 专属特性); 见 docs/configuration.md
set -euo pipefail

bash -n "$0" # 启动自检: 本脚本语法错误即由 set -e 早退, 避免半路挂起
# ── 0. coherd task|push|watch → re-exec 到 venv typer CLI（同一 typer app, 三子命令; spec §7 D8）──
# 置于最顶部 (herdr/jq 检查前): 纯数据 CRUD/记账/兜底不被 launcher runtime 依赖卡死; 且须在 REPO="${1:-$PWD}" 前
# 截获, 防 "task"/"push"/"watch" 被误当 REPO 路径 cd。re-exec 用 repo 根 .venv (install.sh 建), 缺则指引装 install.sh。
HERE_BIN="$(cd "$(dirname "$(readlink -f "$0" 2>/dev/null || echo "$0")")" && pwd)"
case "${1:-}" in
  task|push|watch)
    VENV_COHERD="$HERE_BIN/../.venv/bin/coherd"
    if [ ! -x "$VENV_COHERD" ]; then
      echo "coherd: 未找到 .venv/bin/coherd — 先跑 install.sh (装 coherd task/push/watch CLI)" >&2
      exit 1
    fi
    exec "$VENV_COHERD" "$@"
    ;;
esac

# 帮助: 首参为 -h/--help 时打印 usage 后退出, 不触发后续 cd(否则 --help 会被当目录)
show_usage() { # 精简 usage (不吐整个文件头源码)
  cat <<'EOF'
coherd — 从零拉起 herdr 多 agent 协作集群

用法: coherd [init] [-p|--portrait] [REPO] [LABEL]
  init            强制重建同 label 集群; 普通调用幂等 focus+exit
  -p, --portrait  竖屏布局 (默认横屏; 无需赋值, 存在即竖屏)
  REPO            目标仓库目录 (默认 $PWD)
  LABEL           workspace 标签 (默认 repo basename)

布局: 默认横屏; 加 -p 触发竖屏
EOF
}

INIT=0
PORTRAIT=0
# 循环吃前导开关 (与 --help 对齐: 仅首部位置), 剩余为 [REPO] [LABEL]
while [ "$#" -gt 0 ]; do
  case "$1" in
    -h|--help) show_usage; exit 0 ;;
    init)      INIT=1; shift ;;
    -p|--portrait) PORTRAIT=1; shift ;;
    *) break ;;
  esac
done

REPO="${1:-$PWD}"
REPO="$(cd "$REPO" && pwd)" || exit 1
LABEL="${2:-$(basename "$REPO")}"
CONF="${COHERD_CONF:-$HOME/.config/coherd/coherd.conf}"
CONTRACT="$HOME/.config/coherd/CONTRACT.md"
DETECT_TIMEOUT=120 # pane run 后 herdr 识别 agent + rename 的总超时 (s)
BRIEF_GRACE=15     # 阶段7 brief 送达确认: 每轮宽限等待 seq 涨的秒数 (s)

die()  { echo "coherd: $*" >&2; exit 1; }
info() { echo "coherd: $*"; }
jqr()  { jq -r "$1" <<<"$2"; }


command -v herdr >/dev/null || die "herdr CLI 不在 PATH — 见 docs/configuration.md"
command -v jq    >/dev/null || die "需要 jq — 见 docs/configuration.md"

# ── 0. 加载 coherd.conf (若存在); 已显式设置的 COHERD_* 环境变量优先于 conf ──
if [ -f "$CONF" ]; then
  _pre="$(env | grep -E '^COHERD_[A-Z_]+=' || true)"
  set -a; source "$CONF"; set +a
  while IFS= read -r _kv; do
    [ -n "$_kv" ] && export "$_kv"
  done <<<"$_pre"
  unset _pre _kv
fi

# ── 0.5. 解析三槽位启动命令: CMD 变量 → PATH 回退(pi/omp/cc) → die ──
resolve_cmd() { # role 名 → 命令字符串
  local role="$1" cmd="" fallback
  case "$role" in
    coordinator) cmd="${COHERD_COORDINATOR_CMD:-}"; fallback=pi ;;
    executor)    cmd="${COHERD_EXECUTOR_CMD:-}";    fallback=omp ;;
    reviewer)    cmd="${COHERD_REVIEWER_CMD:-}";    fallback=cc ;;
  esac
  if [ -n "$cmd" ]; then
    printf '%s' "$cmd"
    return 0
  fi
  if command -v "$fallback" >/dev/null 2>&1; then
    printf '%s' "$fallback"
    return 0
  fi
  die "未找到 $role 的启动命令: 未设置对应 COHERD_*_CMD 且 PATH 中无 '$fallback' — 见 docs/configuration.md"
}
COORD_CMD="$(resolve_cmd coordinator)"
EXEC_CMD="$(resolve_cmd executor)"
REV_CMD="$(resolve_cmd reviewer)"

[ -f "$CONTRACT" ] || die "缺 $CONTRACT (公共契约) — 先跑 install.sh 或手动拷贝 roles/CONTRACT.md"

# ── 1. 确保 herdr server (常驻 daemon; bare shell 下 CLI 走 socket) ──
# 注意: `herdr status` 在 server 未运行时退出码仍是 0, 必须解析 --json
server_running() { herdr status --json 2>/dev/null | jq -e '.server.status == "running"' >/dev/null 2>&1; }
if ! server_running; then
  info "herdr server 未运行, 后台拉起 headless server..."
  nohup herdr server >/dev/null 2>&1 &
  for _ in $(seq 1 20); do
    server_running && break
    sleep 1
  done
fi
server_running || die "herdr server 未能就绪 (请先手动运行一次 herdr)"

# ── 2. 幂等: label 查重 ──
EXISTING="$(herdr workspace list 2>/dev/null \
  | jq -r --arg l "$LABEL" '.result.workspaces[] | select(.label==$l) | .workspace_id' \
  | head -1 || true)"
# init: 强制重建 — 先关闭已存在的同 label workspace, 并置空 EXISTING 跳过下方 focus+exit, 续走正常创建
if [ "$INIT" = 1 ] && [ -n "$EXISTING" ]; then
  info "init: 关闭已存在 workspace '$LABEL' ($EXISTING), 将重建"
  herdr workspace close "$EXISTING" >/dev/null || die "init: 关闭已存在 workspace $EXISTING 失败 — 手动 herdr workspace close $EXISTING 后重试"
  EXISTING=""
fi

if [ -n "$EXISTING" ]; then
  info "workspace '$LABEL' 已存在 ($EXISTING), 聚焦后退出"
  herdr workspace focus "$EXISTING" >/dev/null 2>&1 || true
  exit 0
fi

# ── 2.5. 清理 herdr 自动恢复的默认 workspace ──
# herdr server 启动时会从 session.json 恢复默认 workspace (无 label 或 label="~",
# 单 pane 空 shell), 不关则与集群 workspace 并存。只关无 label/~ + 单 pane + 无 agent 的, 避免误伤用户 workspace
while IFS= read -r wid; do
  [ -n "$wid" ] || continue
  herdr workspace close "$wid" >/dev/null 2>&1 && info "已关闭默认 workspace $wid"
done < <(herdr workspace list 2>/dev/null \
  | jq -r '.result.workspaces[]
      | select((.label == null or .label == "" or .label == "~")
               and .pane_count == 1
               and (.agent_status == "unknown" or .agent_status == null))
      | .workspace_id')

# ── 3. 创建 workspace ──
WS_JSON="$(herdr workspace create --cwd "$REPO" --label "$LABEL" --no-focus)"
WS="$(jqr '.result.workspace.workspace_id'  "$WS_JSON")"
ROOT="$(jqr '.result.root_pane.pane_id'     "$WS_JSON")"
[ -n "$WS" ]   && [ "$WS"   != "null" ] || die "workspace create 返回异常: $WS_JSON"
[ -n "$ROOT" ] && [ "$ROOT" != "null" ] || die "workspace create 未返回 root pane: $WS_JSON"
info "workspace=$WS root=$ROOT repo=$REPO label=$LABEL"

# ── 3.5. per-cluster agent 名 (由 workspace 短号小写派生, 避免多集群裸单词撞名
#     → 后者 rename 全败 → null agent)。herdr 名只收 [a-z][a-z0-9_-]{0,31}, 大写被拒
#     (e.g. WS=wG → 前缀 wg → wg-coordinator); 旧 basename 派生命名废弃 ──
WS_SLUG="$(printf '%s' "$WS" | tr '[:upper:]' '[:lower:]')"
COORD_NAME="${WS_SLUG}-coordinator"
EXEC_NAME="${WS_SLUG}-executor"
REV_NAME="${WS_SLUG}-reviewer"
info "agent 命名: $COORD_NAME / $EXEC_NAME / $REV_NAME"

cleanup_hint() { info "失败/中断残留清理: herdr workspace close $WS"; }
trap cleanup_hint ERR

# ── 4. 布局: 默认横屏, -p/--portrait 触发竖屏。不做几何自动检测 ──
if [ "$PORTRAIT" = 1 ]; then
  info "布局: 竖屏 (coordinator 上 / reviewer 中 / executor 下)"
else
  info "布局: 横屏 (reviewer 左上 / executor 右上 / coordinator 下)"
fi

# ── 5. 布局 (先布局后 spawn) ──
SPLIT() { # pane direction [ratio] → 输出新 pane id
  local p="$1" dir="$2" ratio="${3:-}" out
  if [ -n "$ratio" ]; then
    out="$(herdr pane split --pane "$p" --direction "$dir" --ratio "$ratio" --cwd "$REPO" --no-focus)"
  else
    out="$(herdr pane split --pane "$p" --direction "$dir" --cwd "$REPO" --no-focus)"
  fi
  jqr '.result.pane.pane_id' "$out"
}
if [ "$PORTRAIT" = 1 ]; then
  COORD_PANE="$ROOT"
  TMP="$(SPLIT "$ROOT" down 0.3333)"     # 下方 2/3
  REV_PANE="$TMP"
  EXEC_PANE="$(SPLIT "$TMP" down 0.5)"   # 中间 1/3 → reviewer, 底部 1/3 → executor
else
  REV_PANE="$ROOT"
  COORD_PANE="$(SPLIT "$ROOT" down)"     # coordinator 下全宽
  EXEC_PANE="$(SPLIT "$ROOT" right)"     # executor 右上
fi
info "布局: coordinator=$COORD_PANE reviewer=$REV_PANE executor=$EXEC_PANE"

# ── 6. spawn: 三角色统一 launcher (并行 pane run + 共享 deadline 合并检测) ──
# 全部走 pane run <CMD> (CMD 由用户 wrapper/CLI 提供, 自带 env 加载) → 探测 herdr
# 识别出的 agent → rename 成槽位名。无 --kind, 不注入任何 env, 不碰 agent 私有配置。
# 三条 pane run 并行发出(轮流重试各自 pane 就绪, 共享 DETECT_TIMEOUT), 随后单一循环
# 同时检测三 pane 的 agent_status 非 null 并 rename — 最坏总超时 = DETECT_TIMEOUT, 不叠加
start_roles() { # 无参; 用全局 COORD/EXEC/REV_PANE 与 *_CMD
  local deadline=$((SECONDS + DETECT_TIMEOUT)) i all_sent=0 out
  local names=("$COORD_NAME" "$EXEC_NAME" "$REV_NAME")
  local panes=("$COORD_PANE" "$EXEC_PANE" "$REV_PANE")
  local cmds=("$COORD_CMD" "$EXEC_CMD" "$REV_CMD")
  local run_ok=(0 0 0) ids=(0 0 0) blocked_seen=(0 0 0)
  info "启动 coordinator/executor/reviewer (共享超时 ${DETECT_TIMEOUT}s)"
  # 阶段 1: 三条 pane run 并行发出 (pane 未就绪则 2s 后重试, 共享同一 deadline)
  while [ "$SECONDS" -lt "$deadline" ]; do
    all_sent=1
    for i in 0 1 2; do
      if [ "${run_ok[$i]}" = 0 ]; then
        all_sent=0
        if herdr pane run "${panes[$i]}" "${cmds[$i]}" >/dev/null 2>&1; then
          run_ok[$i]=1
          info "pane run ${names[$i]} 已发出"
        fi
      fi
    done
    [ "$all_sent" = 1 ] && break
    sleep 2
  done
  for i in 0 1 2; do
    [ "${run_ok[$i]}" = 1 ] || die "启动 ${names[$i]} 失败 (workspace $WS) — pane 未就绪或命令失败"
  done
  # 阶段 2: 合并检测+rename — 一次轮询覆盖三 pane (agent get 状态跟踪波动会返回 null 假阳性, 故用 list)
  # blocked 不算就绪: 把 blocked 当 ready 会致 '静默假就绪' (agent 起来了但实际卡住, 后续 brief 发了也无人消费)
  while [ "$SECONDS" -lt "$deadline" ]; do
    for i in 0 1 2; do
      [ "${ids[$i]}" = 1 ] && continue
      if herdr agent list 2>/dev/null | jq -e --arg p "${panes[$i]}" \
          '.result.agents[]? | select(.pane_id==$p and .agent_status != null and .agent_status != "blocked")' >/dev/null 2>&1; then
        ids[$i]=1
        out="$(herdr agent rename "${panes[$i]}" "${names[$i]}" 2>&1)" || {
          if [[ "$out" == *agent_name_taken* ]]; then
            die "agent 名 '${names[$i]}' 已被占用(疑似残留/并行集群同名 LABEL?); 先 herdr agent list 查, 再 herdr workspace close 对应 ws"
          fi
          die "rename '${names[$i]}' 失败(原始输出): $out"
        }
      elif herdr agent list 2>/dev/null | jq -e --arg p "${panes[$i]}" \
          '.result.agents[]? | select(.pane_id==$p and .agent_status == "blocked")' >/dev/null 2>&1; then
        # 记录曾见 blocked: deadline 耗尽后据此分支报错(泛型, 不绑 CLI 信任屏字样)
        blocked_seen[$i]=1
      fi
    done
    [ "${ids[0]}" = 1 ] && [ "${ids[1]}" = 1 ] && [ "${ids[2]}" = 1 ] && break
    sleep 2
  done
  # 兜底: deadline 耗尽 — blocked 与未识别分别报错(泛型信息, 不硬编码 CLI/信任屏)
  for i in 0 1 2; do
    [ "${ids[$i]}" = 1 ] && continue
    if [ "${blocked_seen[$i]}" = 1 ]; then
      die "agent ${names[$i]} 卡在 blocked(需人工确认), 检查对应 pane"
    fi
    die "识别 ${names[$i]} 超时 (workspace $WS) — 确认 CMD 是被 herdr 识别的 agent CLI (见 docs/agents.md)"
  done
}
start_roles

# ── 7. 角色事实源 + 启动 brief ──
# 契约文件放全局 (~/.config/coherd/), 不污染项目 git; 所有 herdr agent 共享
# brief 走 fire-and-forget (CONTRACT §2 禁 --wait): 三份并行发出, 无内部轮询, 无送达等待;
# 统一模板: 只给角色身份 + 自身 agent 名 + 双 @ 指路 (公共契约 CONTRACT.md + 角色执行细节 <role>.md) + standby 握手后转 idle 待机, 按消息行动
# 送达确认 (DoD5): fire-and-forget 后用 state_change_seq 有界重投递 —
# seq 涨=文本已消费跳过; 未涨且非 blocked → send-keys enter 补提交(只提交不重发, 防双处理);
# 最多 2 轮宽限(BRIEF_GRACE), 仍无 seq 变化 → WARN 不 die(静默/健谈 cluster 可能不涨 seq=软信号)
herdr workspace focus "$WS" >/dev/null 2>&1 || echo "coherd: WARN: workspace focus 失败, 某些 pane 可能不可见致 brief 文本残留 — 手动在各 pane 回车确认接收" >&2

# 统一 brief 模板: 三角色公共契约全在 CONTRACT.md, per-role 执行细节在对应 <role>.md,
# 双 @ 注入 (物理文件拆开后必须双指针, 单指 CONTRACT 会让角色细节不可达)
_role_doc() { # role 名 → per-role 契约文档路径 (安装目录)
  case "$1" in
    coordinator) printf '%s' "$HOME/.config/coherd/coordinator.md" ;;
    executor)    printf '%s' "$HOME/.config/coherd/executor.md" ;;
    reviewer)    printf '%s' "$HOME/.config/coherd/reviewer.md" ;;
  esac
}
TRACKER_DIR="$HOME/.config/coherd/tasks/$WS_SLUG"
_brief() { printf '你是%s。你的 herdr agent 名: %s。集群公共契约见 @%s (先读), 角色执行细节见 @%s (先读), 任务 tracker 目录见 %s (分派/审查结论落文件)。确认身份后发 standby 握手 (事件) 并转 idle 待机, 按收到的消息行动。' "$1" "$2" "$CONTRACT" "$(_role_doc "$1")" "$TRACKER_DIR"; }
# 送达确认: 用 state_change_seq 有界重投递。先取三角色基线 seq (agent get 失败→空串),
# 每轮 sleep BRIEF_GRACE 后重读 seq; 涨=已消费跳过, 未涨且非 blocked → send-keys enter 补提交
# (只提交不重发 brief 文本, 防双处理); 最多 2 轮宽限, 到期仍无变化 → WARN 不 die
# bash3.2 兼容: 用索引数组, 不用关联数组/mapfile; agent get/jq 失败一律 || true
# 基线采集必须在 brief 派发之前: 快 agent 会在 wait 返回前就消费 brief,
# 若基线滞后会读到消费后值 → now==base 误判未消费 → 白等 2×BRIEF_GRACE + 多余 enter
_seq_names=("$COORD_NAME" "$EXEC_NAME" "$REV_NAME")
_seq_base=("" "" "")
_seq_now=("" "" "")
_seq_done=(0 0 0)
_seq_blocked=(0 0 0)
_i=0
for _n in "${_seq_names[@]}"; do
  _seq_base[$_i]="$(herdr agent get "$_n" 2>/dev/null | jq -r '.result.agent.state_change_seq // ""' 2>/dev/null || true)"
  _i=$((_i + 1))
done
herdr agent prompt "$COORD_NAME" "$(_brief coordinator "$COORD_NAME")" >/dev/null 2>&1 &
_p_coord=$!
herdr agent prompt "$EXEC_NAME" "$(_brief executor "$EXEC_NAME")" >/dev/null 2>&1 &
_p_exec=$!
herdr agent prompt "$REV_NAME" "$(_brief reviewer "$REV_NAME")" >/dev/null 2>&1 &
_p_rev=$!
wait "$_p_coord" || echo "coherd: WARN: brief 投递 COORD 失败" >&2
wait "$_p_exec"  || echo "coherd: WARN: brief 投递 EXEC 失败" >&2
wait "$_p_rev"   || echo "coherd: WARN: brief 投递 REV 失败" >&2
for _round in 1 2; do
  sleep "$BRIEF_GRACE"
  _all_done=1
  for _i in 0 1 2; do
    [ "${_seq_done[$_i]}" = 1 ] && continue
    _n="${_seq_names[$_i]}"
    _seq_now[$_i]="$(herdr agent get "$_n" 2>/dev/null | jq -r '.result.agent.state_change_seq // ""' 2>/dev/null || true)"
    # seq 变化 = brief 已被消费
    if [ -n "${_seq_now[$_i]}" ] && [ "${_seq_now[$_i]}" != "${_seq_base[$_i]}" ]; then
      _seq_done[$_i]=1
      continue
    fi
    _all_done=0
    # 仅在非 blocked 时补 enter (blocked 本不该到此, 阶段6 已拦截; 但仍二次判别防误)
    _st_blocked="$(herdr agent get "$_n" 2>/dev/null | jq -r '.result.agent.agent_status == "blocked"' 2>/dev/null || true)"
    if [ "$_st_blocked" = "true" ]; then
      _seq_blocked[$_i]=1
      continue
    fi
    # 文本已滞在 pane, 只提交不清空, 不重发 brief (防双处理)
    herdr agent send-keys "$_n" enter >/dev/null 2>&1 || true
  done
  [ "$_all_done" = 1 ] && break
done
# 2 轮宽限后仍未消费 → WARN 不 die (静默/健谈 cluster 可能不涨 seq = 软信号, 误 die 反伤)
for _i in 0 1 2; do
  [ "${_seq_done[$_i]}" = 1 ] && continue
  _n="${_seq_names[$_i]}"
  if [ "${_seq_blocked[$_i]}" = 1 ]; then
    echo "coherd: WARN: brief 疑似未消费(角色 blocked) $_n — 手动检查 pane" >&2
  else
    echo "coherd: WARN: brief 疑似未消费 $_n — 手动检查 pane" >&2
  fi
done
unset _n _i _round _all_done _st_blocked _seq_names _seq_base _seq_now _seq_done _seq_blocked _brief _role_doc

# ── 7.5. 拉起单例 watcher（断链兜底, spec §7/§8 不变量 1）──
# 非阻塞后台 (&) 起 coherd watch --ws $WS_SLUG：watcher 挂=只失兜底, 不拖垮起集群主流程。
# 幂等: 先探测 pid 锁文件 (~/.config/coherd/watch.pid) 有存活进程则跳过; watch 自身 pid 锁(已实现)是第二道防。
# 起失败 / 探测出错 → WARN 不 die（收敛于不变量 1: push 不依赖 watcher 存活, 集群照常就绪）。
VCOHERD="$HERE_BIN/../.venv/bin/coherd"
_watch_alive=0
# 探测路径与 watch 写锁路径对齐: watch.py 用 CONFIG_HOME=COHERD_CONFIG_HOME 派生 PID_FILE
# (缺省 ~/.config/coherd)。不一致会导致幂等探测失准(多起一次,仍被 watch 自身锁拒)。
_WATCH_CONFIG_HOME="${COHERD_CONFIG_HOME:-$HOME/.config/coherd}"
if [ -f "$_WATCH_CONFIG_HOME/watch.pid" ]; then
  _wpid="$(cat "$_WATCH_CONFIG_HOME/watch.pid" 2>/dev/null || true)"
  if [ -n "$_wpid" ] && kill -0 "$_wpid" 2>/dev/null; then
    _watch_alive=1
  fi
fi
if [ "$_watch_alive" = 1 ]; then
  info "watch 已在运行(pid $_wpid), 跳过拉起 (幂等)"
elif [ -x "$VCOHERD" ]; then
  "$VCOHERD" watch --ws "$WS_SLUG" >/dev/null 2>&1 &
  if [ $? -eq 0 ]; then
    info "已后台拉起 watch (ws=$WS_SLUG)"
  else
    echo "coherd: WARN: watch 拉起失败(非阻塞, 不阻断集群) — 断链兜底暂缺, 可手动 coherd watch --ws $WS_SLUG &" >&2
  fi
else
  echo "coherd: WARN: 缺 .venv/bin/coherd, 未拉起 watch (先跑 install.sh)" >&2
fi
unset _wpid _watch_alive VCOHERD _WATCH_CONFIG_HOME

info "集群就绪: workspace=$WS  coordinator=$COORD_PANE  reviewer=$REV_PANE  executor=$EXEC_PANE  (契约见 $CONTRACT + per-role; 依赖 herdr ≥ 需支持上述 pane/agent 操作)"
