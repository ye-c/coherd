#!/usr/bin/env bash
# coherd — 从零拉起 herdr 多 agent 协作集群
#
# 用法: coherd [init] [-s|--simple] [-p|--portrait|-t|--tabs] [--agent role=cmd[,...]] [REPO] [LABEL]
#   init  强制(重)建: 该 label 的 workspace 已存在则先关闭再走正常创建; 不存在则等价普通创建
#   REPO  目标仓库目录 (默认 $PWD)
#   LABEL workspace 标签   (默认 repo basename)
#   --agent 按角色覆盖本次启动命令 (如 --agent lead=codex,dev=opencode): 试其他 agent CLI 用, 不碰全局 conf;
#           优先级 --agent > COHERD_*_CMD > PATH 回退
#
# 角色:  coordinator 协调 (可与 reviewer 讨论) / executor 执行 / reviewer 审查
#   三角色均为「槽位」, 具体 agent CLI 由配置决定, 本脚本不绑定任何特定 CLI:
#     COHERD_COORDINATOR_CMD / COHERD_EXECUTOR_CMD / COHERD_REVIEWER_CMD
#     未设置时 coordinator/reviewer 回退 pi、executor 回退 omp; 均缺则 die 指向 docs/configuration.md
#   agent 私有配置 (env/flag/wrapper 内容) 由用户自备, 本脚本不注入不修改
#
# 双角色简易模式: -s/--simple → lead(检查者: 协调+审查合一) + dev(执行者) 两 tab (1 lead / 2 dev)
#   命令: COHERD_LEAD_CMD / COHERD_DEV_CMD; 未设置时回退 lead→COHERD_COORDINATOR_CMD→pi, dev→COHERD_EXECUTOR_CMD→omp
#   契约: CONTRACT-simple.md + lead.md / dev.md (三角色模式零改动, 两模式以 -s 切换)
#
# 布局:  默认横屏; 需竖屏时传 -p/--portrait, 需每角色独立 tab 时传 -t/--tabs (均为无赋值 flag)。
#   不做几何自动检测 (headless 场景拿不到真实屏幕, 自动判横竖不可靠)
#   横屏: reviewer 左上 / executor 右上 / coordinator 下全宽
#   竖屏: coordinator 上 / reviewer 中 / executor 下 (均分三行)
#   tabs:  每角色一 tab (1 coord / 2 rev / 3 exec), 4-libero 预留空 tab 交用户手动加载
#   simple(-s): 恒两 tab (1 lead / 2 dev), 无需传 -t; -s -p 无意义(恒 tabs), 忽略并告警
#
# 幂等:  按 workspace label 查重, 已存在则聚焦后退出 (不重建); init 子命令除外: 先 close 再重建
# 失败:  set -euo pipefail, ERR 时提示 workspace_id 供手动清理
# 依赖:  herdr, jq; 兼容 bash 3.2 (不用 bash4 专属特性); 见 docs/configuration.md
set -euo pipefail

bash -n "$0" # 启动自检: 本脚本语法错误即由 set -e 早退, 避免半路挂起
# ── 0. coherd task/feedback/notify → re-exec 到 venv typer CLI（同一 typer app）──
# 置于最顶部 (herdr/jq 检查前): 纯数据 CRUD/回执登记不被 launcher runtime 依赖卡死; 且须在 REPO="${1:-$PWD}" 前
# 截获, 防 "task"/"push"/"watch" 被误当 REPO 路径 cd。re-exec 用 repo 根 .venv (install.sh 建), 缺则指引装 install.sh。
HERE_BIN="$(cd "$(dirname "$(readlink -f "$0" 2>/dev/null || echo "$0")")" && pwd)"
# case 保留 push/watch token：两者已废弃（push→feedback/notify；watch→消息自描述软方案），
# 但经此路由到 venv CLI 报干净的 "No such command 'push'/'watch'"（否则 fallthrough 当 REPO 目录 cd 误导）。
# feedback/notify 为现行命令。
case "${1:-}" in
  task|push|watch|feedback|notify)
    VENV_COHERD="$HERE_BIN/../.venv/bin/coherd"
    if [ ! -x "$VENV_COHERD" ]; then
      echo "coherd: 未找到 .venv/bin/coherd — 先跑 install.sh (装 coherd task/feedback/notify CLI)" >&2
    fi
    exec "$VENV_COHERD" "$@"
    ;;
esac

# 帮助: 首参为 -h/--help 时打印 usage 后退出, 不触发后续 cd(否则 --help 会被当目录)
show_usage() { # 精简 usage (不吐整个文件头源码)
  cat <<'EOF'
coherd — 从零拉起 herdr 多 agent 协作集群

用法: coherd [init] [-s|--simple] [-p|--portrait] [-t|--tabs] [--agent role=cmd[,...]] [REPO] [LABEL]
  init            强制重建同 label 集群; 普通调用幂等 focus+exit
  -s, --simple    双角色简易模式 (lead / dev 两 tab, 恒 tabs 无需 -t); 契约 CONTRACT-simple.md; -p 忽略并告警
  -p, --portrait  竖屏布局 (默认横屏); -t 时忽略
  -t, --tabs      每角色独立 tab (普通模式 1 coord / 2 rev / 3 exec / 4 libero 手动); 与 -p 互斥, 优先 tabs; simple 模式恒 tabs, 此 flag 冗余
  --agent         按角色覆盖本次启动的 agent 命令 (如 --agent lead=codex,dev=opencode); 优先于 COHERD_*_CMD 与 PATH 回退
  REPO            目标仓库目录 (默认 $PWD)
  LABEL           workspace 标签 (默认 repo basename)

布局: 默认横屏; 加 -p 竖屏; 加 -t 每角色独立 tab (含手动 libero tab)
      simple(-s): lead / dev 两 tab (1 lead / 2 dev)
EOF
}

INIT=0
SIMPLE=0
PORTRAIT=0
TABS=0
AGENT_ARGS=""  # --agent 值 (role=cmd 逗号分隔); 空 = 不覆盖
# 循环吃前导开关 (与 --help 对齐: 仅首部位置), 剩余为 [REPO] [LABEL]
while [ "$#" -gt 0 ]; do
  case "$1" in
    -h|--help) show_usage; exit 0 ;;
    init)      INIT=1; shift ;;
    -s|--simple) SIMPLE=1; shift ;;
    -p|--portrait) PORTRAIT=1; shift ;;
    -t|--tabs) TABS=1; shift ;;
    # 此时 die 尚未定义(在下方), 故缺参直接报错退出
    --agent)   [ -n "${2:-}" ] || { echo "coherd: --agent 需要参数 (格式: role=cmd[,role=cmd])" >&2; exit 1; }
               AGENT_ARGS="$2"; shift 2 ;;
    --agent=*) AGENT_ARGS="${1#*=}"; shift ;;
    *) break ;;
  esac
done
# simple 恒 tabs, -p 无意义
if [ "$SIMPLE" = 1 ] && [ "$PORTRAIT" = 1 ]; then
  echo "coherd: -s 模式下 -p 无意义 (simple 恒两 tab), 已忽略" >&2
  PORTRAIT=0
fi

REPO="${1:-$PWD}"
REPO="$(cd "$REPO" && pwd)" || exit 1
LABEL="${2:-$(basename "$REPO")}"
CONF="${COHERD_CONF:-$HOME/.config/coherd/coherd.conf}"
CONTRACT_SIMPLE="$HOME/.config/coherd/CONTRACT-simple.md"
CONTRACT="$HOME/.config/coherd/CONTRACT.md"
# simple 模式的事实源是 CONTRACT-simple.md (brief 指路 + 存在性检查都跟随模式)
if [ "$SIMPLE" = 1 ]; then
  CONTRACT="$CONTRACT_SIMPLE"
  RECEIPT_REF="CONTRACT-simple §2 (唯一权威)"
else
  RECEIPT_REF="CONTRACT §7 D10 (唯一权威)"
fi
DETECT_TIMEOUT=120 # pane run 后 herdr 识别 agent + rename 的总超时 (s)
BRIEF_GRACE=15     # 阶段7 brief 送达确认: 每轮宽限等待 seq 涨的秒数 (s)

die()  { echo "coherd: $*" >&2; exit 1; }
info() { echo "coherd: $*"; }
jqr()  { jq -r "$1" <<<"$2"; }


command -v herdr >/dev/null || die "herdr CLI 不在 PATH — 见 docs/configuration.md"
command -v jq    >/dev/null || die "需要 jq — 见 docs/configuration.md"

# ── 0.1 herdr 版本可见性 (fail-open: 取不到版本号就静默跳过, 不报错不阻断) ──
# 为什么打一行: brief 送达逻辑依赖 herdr 输入框行为 (见 §7 注释), 升级曾坏过一次 (w54)。
# 兼容基线 0.9.x = 当前实测; 区间外只 WARN 不阻断 (用户可能已在更新版本上跑通)。
# tests/smoke/bin/herdr 是 stub, 不认 --version (落到 *) 分支无输出) → 静默跳过, 不会把 smoke 打挂。
_herdr_ver="$(herdr --version 2>/dev/null | head -1 || true)"
_herdr_num="${_herdr_ver##* }"
case "$_herdr_num" in
  [0-9]*.[0-9]*.[0-9]*)
    info "herdr $_herdr_num"
    case "$_herdr_num" in
      0.9.*) ;;
      *) echo "coherd: WARN: herdr $_herdr_num 不在已知兼容区间 0.9.x — brief 送达依赖 prompt 输入框行为, 升级后先跑 tests/smoke/run_smoke.sh" >&2 ;;
    esac ;;
esac
unset _herdr_ver _herdr_num

# ── 0. 加载 coherd.conf (若存在); 已显式设置的 COHERD_* 环境变量优先于 conf ──
if [ -f "$CONF" ]; then
  _pre="$(env | grep -E '^COHERD_[A-Z_]+=' || true)"
  set -a; source "$CONF"; set +a
  while IFS= read -r _kv; do
    [ -n "$_kv" ] && export "$_kv"
  done <<<"$_pre"
  unset _pre _kv
fi

# ── 0.5. 解析启动命令: --agent 覆盖 → CMD 变量 → PATH 回退(pi/omp) → die ──
#   simple 追加 lead/dev: lead → COHERD_LEAD_CMD → COHERD_COORDINATOR_CMD → pi
#                            dev  → COHERD_DEV_CMD  → COHERD_EXECUTOR_CMD  → omp
# 唯一权威角色表 (校验/报错通用, 不另处硬编码)
ROLES_ALL="coordinator executor reviewer lead dev"
_find_role() { # $1=待查角色名 → 命中打印自身; 未命中无输出
  local r
  for r in $ROLES_ALL; do
    if [ "$r" = "$1" ]; then printf '%s' "$r"; return 0; fi
  done
}
# --agent 校验: 未知名/缺 '='/空命令 一律 die 且不启动 (防拼错被静默忽略)
if [ -n "$AGENT_ARGS" ]; then
  IFS=',' read -ra _agent_pairs <<<"$AGENT_ARGS"
  for _pair in "${_agent_pairs[@]}"; do
    case "$_pair" in
      *=*) ;;
      *) die "--agent: '$_pair' 缺 '=' (格式 role=cmd)" ;;
    esac
    _ar="${_pair%%=*}"
    [ -n "$(_find_role "$_ar")" ] || die "--agent: 未知角色 '$_ar' (可选 ${ROLES_ALL// /|})"
    [ -n "${_pair#*=}" ] || die "--agent: '$_pair' 缺命令"
  done
  unset _agent_pairs _pair _ar
fi
agent_override() { # role 名 → 该角色的 --agent 覆盖命令 (无覆盖则空)
  local role="$1" pair pairs
  if [ -n "$AGENT_ARGS" ]; then
    IFS=',' read -ra pairs <<<"$AGENT_ARGS"
    for pair in "${pairs[@]}"; do
      case "$pair" in
        "$role"=*) printf '%s' "${pair#*=}"; return 0 ;;
      esac
    done
  fi
  return 0
}
resolve_cmd() { # role 名 → 命令字符串
  local role="$1" cmd="" fallback ov
  case "$role" in
    coordinator) cmd="${COHERD_COORDINATOR_CMD:-}"; fallback=pi ;;
    executor)    cmd="${COHERD_EXECUTOR_CMD:-}";    fallback=omp ;;
    reviewer)    cmd="${COHERD_REVIEWER_CMD:-}";    fallback=pi ;;
    # fallback 兼容三角色配置: 未设 simple 专属 CMD 时复用已配的 coordinator/executor 命令
    lead)        cmd="${COHERD_LEAD_CMD:-${COHERD_COORDINATOR_CMD:-}}"; fallback=pi ;;
    dev)         cmd="${COHERD_DEV_CMD:-${COHERD_EXECUTOR_CMD:-}}";     fallback=omp ;;
  esac
  ov="$(agent_override "$role")"
  if [ -n "$ov" ]; then cmd="$ov"; fi   # --agent 本次运行覆盖优先于 COHERD_*_CMD
  if [ -n "$cmd" ]; then
    printf '%s' "$cmd"
    return 0
  fi
  if command -v "$fallback" >/dev/null 2>&1; then
    printf '%s' "$fallback"
    return 0
  fi
  die "未找到 $role 的启动命令: 未设置对应 COHERD_*_CMD 且 PATH 中无 '$fallback' — 见 docs/configuration.md"
}
if [ "$SIMPLE" = 1 ]; then
  LEAD_CMD="$(resolve_cmd lead)"
  DEV_CMD="$(resolve_cmd dev)"
else
  COORD_CMD="$(resolve_cmd coordinator)"
  EXEC_CMD="$(resolve_cmd executor)"
  REV_CMD="$(resolve_cmd reviewer)"
fi

[ -f "$CONTRACT" ] || die "缺 $CONTRACT (公共契约) — 先跑 install.sh 或手动拷贝 roles/CONTRACT.md"

# ── 1. 确保 herdr server (常驻 daemon; bare shell 下 CLI 走 socket) ──
# 注意: `herdr status` 在 server 未运行时退出码仍是 0, 必须解析 --json
server_running() { herdr status --json 2>/dev/null | jq -e '.server.status == "running"' >/dev/null 2>&1; }
if ! server_running; then
  info "herdr server 未运行, 后台拉起 headless server..."
  nohup herdr server >/dev/null 2>&1 &
  for _ in $(seq 1 20); do
    server_running && break
    sleep 1
  done
fi
server_running || die "herdr server 未能就绪 (请先手动运行一次 herdr)"

# ── 2. 幂等: label 查重 ──
EXISTING="$(herdr workspace list 2>/dev/null \
  | jq -r --arg l "$LABEL" '.result.workspaces[] | select(.label==$l) | .workspace_id' \
  | head -1 || true)"
# init: 强制重建 — 先关闭已存在的同 label workspace, 并置空 EXISTING 跳过下方 focus+exit, 续走正常创建
if [ "$INIT" = 1 ] && [ -n "$EXISTING" ]; then
  info "init: 关闭已存在 workspace '$LABEL' ($EXISTING), 将重建"
  herdr workspace close "$EXISTING" >/dev/null || die "init: 关闭已存在 workspace $EXISTING 失败 — 手动 herdr workspace close $EXISTING 后重试"
  EXISTING=""
fi

if [ -n "$EXISTING" ]; then
  info "workspace '$LABEL' 已存在 ($EXISTING), 聚焦后退出"
  herdr workspace focus "$EXISTING" >/dev/null 2>&1 || true
  exit 0
fi

# ── 2.5. 清理 herdr 自动恢复的默认 workspace ──
# herdr server 启动时会从 session.json 恢复默认 workspace (无 label 或 label="~",
# 单 pane 空 shell), 不关则与集群 workspace 并存。只关无 label/~ + 单 pane + 无 agent 的, 避免误伤用户 workspace
while IFS= read -r wid; do
  [ -n "$wid" ] || continue
  herdr workspace close "$wid" >/dev/null 2>&1 && info "已关闭默认 workspace $wid"
done < <(herdr workspace list 2>/dev/null \
  | jq -r '.result.workspaces[]
      | select((.label == null or .label == "" or .label == "~")
               and .pane_count == 1
               and (.agent_status == "unknown" or .agent_status == null))
      | .workspace_id')

# ── 3. 创建 workspace ──
WS_JSON="$(herdr workspace create --cwd "$REPO" --label "$LABEL" --no-focus)"
WS="$(jqr '.result.workspace.workspace_id'  "$WS_JSON")"
ROOT="$(jqr '.result.root_pane.pane_id'     "$WS_JSON")"
[ -n "$WS" ]   && [ "$WS"   != "null" ] || die "workspace create 返回异常: $WS_JSON"
[ -n "$ROOT" ] && [ "$ROOT" != "null" ] || die "workspace create 未返回 root pane: $WS_JSON"
info "workspace=$WS root=$ROOT repo=$REPO label=$LABEL"

# ── 3.5. per-cluster agent 名 (由 workspace 短号小写派生, 避免多集群裸单词撞名
#     → 后者 rename 全败 → null agent)。herdr 名只收 [a-z][a-z0-9_-]{0,31}, 大写被拒
#     (e.g. WS=wG → 前缀 wg → wg-coordinator); 旧 basename 派生命名废弃 ──
WS_SLUG="$(printf '%s' "$WS" | tr '[:upper:]' '[:lower:]')"
if [ "$SIMPLE" = 1 ]; then
  LEAD_NAME="${WS_SLUG}-lead"
  DEV_NAME="${WS_SLUG}-dev"
  info "agent 命名: $LEAD_NAME / $DEV_NAME"
else
  COORD_NAME="${WS_SLUG}-coordinator"
  EXEC_NAME="${WS_SLUG}-executor"
  REV_NAME="${WS_SLUG}-reviewer"
  info "agent 命名: $COORD_NAME / $EXEC_NAME / $REV_NAME"
fi

cleanup_hint() { info "失败/中断残留清理: herdr workspace close $WS"; }
trap cleanup_hint ERR

# ── 4. 布局: 默认横屏; -p 竖屏; -t 每角色独立 tab (与 -p 互斥, tabs 优先)。不做几何自动检测 ──
if [ "$PORTRAIT" = 1 ] && [ "$TABS" = 1 ]; then
  info "-t 与 -p 同时给出, 以 tabs 为准 (忽略竖屏)"
fi
SPLIT() { # pane direction [ratio] → 输出新 pane id
  local p="$1" dir="$2" ratio="${3:-}" out
  if [ -n "$ratio" ]; then
    out="$(herdr pane split --pane "$p" --direction "$dir" --ratio "$ratio" --cwd "$REPO" --no-focus)"
  else
    out="$(herdr pane split --pane "$p" --direction "$dir" --cwd "$REPO" --no-focus)"
  fi
  jqr '.result.pane.pane_id' "$out"
}
# tab create 镜像 SPLIT (返回新 pane id), 仅建 tab 不 spawn; root tab 已含 coord pane
TAB() { # label → 新 tab 的 root pane id
  local label="$1" out
  out="$(herdr tab create --workspace "$WS" --cwd "$REPO" --label "$label")"
  jqr '.result.root_pane.pane_id' "$out"
}
# simple(-s): 恒两 tab (root tab 已含 lead pane) — 上下 pane 布局已废弃
if [ "$SIMPLE" = 1 ]; then
  LEAD_PANE="$ROOT"
  ROOT_TAB="$(jqr '.result.workspace.active_tab_id' "$(herdr workspace get "$WS")")"
  herdr tab rename "$ROOT_TAB" lead >/dev/null 2>&1 || true
  DEV_PANE="$(TAB dev)"             # tab#2
  info "布局: tabs (lead=$LEAD_PANE / dev=$DEV_PANE)"
elif [ "$TABS" = 1 ]; then
  COORD_PANE="$ROOT"                # root tab(#1) 已建, pane=coordinator
  # root tab 默认 label 为其编号 "1"; 改名 coord 使四 tab 标签统一 coord/rev/exec/libero
  ROOT_TAB="$(jqr '.result.workspace.active_tab_id' "$(herdr workspace get "$WS")")"
  herdr tab rename "$ROOT_TAB" coord >/dev/null 2>&1 || true
  REV_PANE="$(TAB rev)"             # tab#2
  EXEC_PANE="$(TAB exec)"           # tab#3
  LIBERO_PANE="$(TAB libero)"       # tab#4 手动角色, 不 spawn
  info "布局: tabs (coord=$COORD_PANE / rev=$REV_PANE / exec=$EXEC_PANE / libero=$LIBERO_PANE, libero 手动)"
elif [ "$PORTRAIT" = 1 ]; then
  COORD_PANE="$ROOT"
  TMP="$(SPLIT "$ROOT" down 0.3333)"     # 下方 2/3
  REV_PANE="$TMP"
  EXEC_PANE="$(SPLIT "$TMP" down 0.5)"   # 中间 1/3 → reviewer, 底部 1/3 → executor
  info "布局: 竖屏 (coordinator 上 / reviewer 中 / executor 下)"
else
  REV_PANE="$ROOT"
  COORD_PANE="$(SPLIT "$ROOT" down)"     # coordinator 下全宽
  EXEC_PANE="$(SPLIT "$ROOT" right)"     # executor 右上
  info "布局: 横屏 (reviewer 左上 / executor 右上 / coordinator 下)"
fi
if [ "$SIMPLE" = 1 ]; then
  info "布局: lead=$LEAD_PANE dev=$DEV_PANE"
else
  info "布局: coordinator=$COORD_PANE reviewer=$REV_PANE executor=$EXEC_PANE"
fi

# ── 6. spawn: 统一 launcher (并行 pane run + 共享 deadline 合并检测) ──
# 全部走 pane run <CMD> (CMD 由用户 wrapper/CLI 提供, 自带 env 加载) → 探测 herdr
# 识别出的 agent → rename 成槽位名。无 --kind, 不注入任何 env, 不碰 agent 私有配置。
# N 条 pane run 并行发出(轮流重试各自 pane 就绪, 共享 DETECT_TIMEOUT), 随后单一循环
# 同时检测 N pane 的 agent_status 非 null 并 rename — 最坏总超时 = DETECT_TIMEOUT, 不叠加
# N 由模式决定: simple=2 (lead/dev), 三角色=3; start_roles 不硬编码角色数 (R5)
if [ "$SIMPLE" = 1 ]; then
  ROLE_NAMES=("$LEAD_NAME" "$DEV_NAME")
  ROLE_PANES=("$LEAD_PANE" "$DEV_PANE")
  ROLE_CMDS=("$LEAD_CMD" "$DEV_CMD")
else
  ROLE_NAMES=("$COORD_NAME" "$EXEC_NAME" "$REV_NAME")
  ROLE_PANES=("$COORD_PANE" "$EXEC_PANE" "$REV_PANE")
  ROLE_CMDS=("$COORD_CMD" "$EXEC_CMD" "$REV_CMD")
fi
start_roles() { # 无参; 用全局 ROLE_NAMES / ROLE_PANES / ROLE_CMDS (长度即角色数)
  local deadline=$((SECONDS + DETECT_TIMEOUT)) i n all_sent=0 out
  n=${#ROLE_NAMES[@]}
  local run_ok=() ids=() blocked_seen=()   # 稀疏赋值, 读处用 ${x[$i]:-0} 兼容 set -u
  info "启动 ${ROLE_NAMES[*]} (共享超时 ${DETECT_TIMEOUT}s)"
  # 阶段 1: N 条 pane run 并行发出 (pane 未就绪则 2s 后重试, 共享同一 deadline)
  while [ "$SECONDS" -lt "$deadline" ]; do
    all_sent=1
    for (( i = 0; i < n; i++ )); do
      if [ "${run_ok[$i]:-0}" = 0 ]; then
        all_sent=0
        if herdr pane run "${ROLE_PANES[$i]}" "${ROLE_CMDS[$i]}" >/dev/null 2>&1; then
          run_ok[$i]=1
          info "pane run ${ROLE_NAMES[$i]} 已发出"
        fi
      fi
    done
    [ "$all_sent" = 1 ] && break
    sleep 2
  done
  for (( i = 0; i < n; i++ )); do
    [ "${run_ok[$i]:-0}" = 1 ] || die "启动 ${ROLE_NAMES[$i]} 失败 (workspace $WS) — pane 未就绪或命令失败"
  done
  # 阶段 2: 合并检测+rename — 一次轮询覆盖 N pane (agent get 状态跟踪波动会返回 null 假阳性, 故用 list)
  # blocked 不算就绪: 把 blocked 当 ready 会致 '静默假就绪' (agent 起来了但实际卡住, 后续 brief 发了也无人消费)
  while [ "$SECONDS" -lt "$deadline" ]; do
    for (( i = 0; i < n; i++ )); do
      [ "${ids[$i]:-0}" = 1 ] && continue
      if herdr agent list 2>/dev/null | jq -e --arg p "${ROLE_PANES[$i]}" \
          '.result.agents[]? | select(.pane_id==$p and .agent_status != null and .agent_status != "blocked")' >/dev/null 2>&1; then
        ids[$i]=1
        out="$(herdr agent rename "${ROLE_PANES[$i]}" "${ROLE_NAMES[$i]}" 2>&1)" || {
          if [[ "$out" == *agent_name_taken* ]]; then
            die "agent 名 '${ROLE_NAMES[$i]}' 已被占用(疑似残留/并行集群同名 LABEL?); 先 herdr agent list 查, 再 herdr workspace close 对应 ws"
          fi
          die "rename '${ROLE_NAMES[$i]}' 失败(原始输出): $out"
        }
      elif herdr agent list 2>/dev/null | jq -e --arg p "${ROLE_PANES[$i]}" \
          '.result.agents[]? | select(.pane_id==$p and .agent_status == "blocked")' >/dev/null 2>&1; then
        # 记录曾见 blocked: deadline 耗尽后据此分支报错(泛型, 不绑 CLI 信任屏字样)
        blocked_seen[$i]=1
      fi
    done
    all_sent=1
    for (( i = 0; i < n; i++ )); do
      [ "${ids[$i]:-0}" = 1 ] || all_sent=0
    done
    [ "$all_sent" = 1 ] && break
    sleep 2
  done
  # 兜底: deadline 耗尽 — blocked 与未识别分别报错(泛型信息, 不硬编码 CLI/信任屏)
  for (( i = 0; i < n; i++ )); do
    [ "${ids[$i]:-0}" = 1 ] && continue
    if [ "${blocked_seen[$i]:-0}" = 1 ]; then
      die "agent ${ROLE_NAMES[$i]} 卡在 blocked(需人工确认), 检查对应 pane"
    fi
    die "识别 ${ROLE_NAMES[$i]} 超时 (workspace $WS) — 确认 CMD 是被 herdr 识别的 agent CLI (见 docs/agents.md)"
  done
}
start_roles

# ── 7. 角色事实源 + 启动 brief ──
# 契约文件放全局 (~/.config/coherd/), 不污染项目 git; 所有 herdr agent 共享
# brief 走 fire-and-forget (CONTRACT §2 禁 --wait): 每角色一份并行发出, 无内部轮询, 无送达等待;
# 统一模板: 只给角色身份 + 自身 agent 名 + 双 @ 指路 (公共契约 + 角色执行细节 <role>.md) + standby 握手后转 idle 待机, 按消息行动
# 送达确认: fire-and-forget 后用 state_change_seq 有界重投递 —
# herdr 升级后 prompt 对全 kind 只把 brief paste 进输入框不提交且 seq 在文本到达即涨(非消费),
# 故一律先 send-keys enter 提交框内文本(只提交不重发, 防双处理), 再验 Enter 后 seq 涨确认真消费;
# 最多 2 轮宽限(BRIEF_GRACE), 仍无 seq 变化 → WARN 不 die(静默/健谈 cluster 可能不涨 seq=软信号)
herdr workspace focus "$WS" >/dev/null 2>&1 || echo "coherd: WARN: workspace focus 失败, 某些 pane 可能不可见致 brief 文本残留 — 手动在各 pane 回车确认接收" >&2

# 统一 brief 模板: 公共契约 (三角色 CONTRACT.md / simple CONTRACT-simple.md) + per-role 执行细节在对应 <role>.md,
# 双 @ 注入 (物理文件拆开后必须双指针, 单指 CONTRACT 会让角色细节不可达)
_role_doc() { # role 名 → per-role 契约文档路径 (安装目录)
  case "$1" in
    coordinator) printf '%s' "$HOME/.config/coherd/coordinator.md" ;;
    executor)    printf '%s' "$HOME/.config/coherd/executor.md" ;;
    reviewer)    printf '%s' "$HOME/.config/coherd/reviewer.md" ;;
    lead)        printf '%s' "$HOME/.config/coherd/lead.md" ;;
    dev)         printf '%s' "$HOME/.config/coherd/dev.md" ;;
  esac
}
# session 目录: 每启动一目录, 平铺任务文档; $$ 防同 ws 秒级二次启动撞目录 (不 export, agent pane 不继承 env)
TASK_TS="$(date +%Y%m%d%H%M%S)"
SESSION_DIR="$HOME/.config/coherd/sessions/${WS_SLUG}-${TASK_TS}-$$"
mkdir -p "$SESSION_DIR"
_contract_fp() { # 公共契约文件 → "契约指纹: <sha256 前 8 位>"; 取不到则无输出 (调用方跳过该行)
  local f="$1" h=""
  [ -f "$f" ] || return 0
  if command -v sha256sum >/dev/null 2>&1; then
    h="$(sha256sum "$f" 2>/dev/null | cut -c1-8)"
  elif command -v shasum >/dev/null 2>&1; then
    h="$(shasum -a 256 "$f" 2>/dev/null | cut -c1-8)"
  fi
  [ -n "$h" ] && printf '契约指纹: %s' "$h"
  return 0
}
_brief() { # 身份+名字 + 双@指路 + session + 契约指纹 + 待机 + 回执唯一权威 (精简版, 只引不重述)
  local _standby _fp; case "$1" in
    executor|reviewer) _standby="读 CONTRACT 确认身份后发 \`coherd notify $COORD_NAME \"standby\"\` 再转 idle" ;;
    coordinator)       _standby="确认身份转 idle; exec/rev 的 standby 被动接收不回执" ;;
    # simple: 单 standby 握手 (spec D5) — dev 发一条给 lead, lead 被动接收不回执
    dev)               _standby="读 CONTRACT-simple 确认身份后发 \`coherd notify $LEAD_NAME \"standby\"\` 再转 idle" ;;
    lead)              _standby="确认身份转 idle; dev 的 standby 被动接收不回执" ;;
  esac
  # 契约指纹: 让人一眼看出 agent 读的那份 (~/.config/coherd/) 是否与 repo 漂移
  _fp="$(_contract_fp "$CONTRACT")"
  [ -n "$_fp" ] && _fp="
$_fp"
  printf '你是 %s · agent 名 %s\n公共契约 @%s\n角色细节 @%s\nsession %s%s\n\n待机: %s\n回执: %s' \
    "$1" "$2" "$CONTRACT" "$(_role_doc "$1")" "$SESSION_DIR" "$_fp" "$_standby" "$RECEIPT_REF"
}
# 送达确认: 用 state_change_seq 有界重投递。先取三角色基线 seq (agent get 失败→空串),
# 第1轮 sleep BRIEF_GRACE 后统一 send-keys enter 提交框内文本, 第2轮重读 seq 验消费(涨=已消费);
# (只提交不重发 brief 文本, 防双处理); 最多 2 轮宽限, 到期仍无变化 → WARN 不 die
# 输入框型 TUI: herdr 升级后 agent prompt 对所有 CLI 都只把 brief 文本放进输入框, state_change_seq 在
#    "文本到达" 即涨(非消费) → "涨=已消费" 误判 → 跳过补 enter → brief 滞留框内需人工回车。
#    故对全部 kind 不信任 seq, 一律先显式 send-keys enter 提交, 再据 Enter 后 seq 涨确认真消费。
# bash3.2 兼容: 用索引数组, 不用关联数组/mapfile; agent get/jq 失败一律 || true
# 基线采集必须在 brief 派发之前: 快 agent 会在 wait 返回前就消费 brief,
# 若基线滞后会读到消费后值 → now==base 误判未消费 → 白等 2×BRIEF_GRACE + 多余 enter
_seq_roles=() _seq_names=()
if [ "$SIMPLE" = 1 ]; then
  _seq_roles=("lead" "dev")
  _seq_names=("$LEAD_NAME" "$DEV_NAME")
else
  _seq_roles=("coordinator" "executor" "reviewer")
  _seq_names=("$COORD_NAME" "$EXEC_NAME" "$REV_NAME")
fi
_n_roles=${#_seq_names[@]}
_seq_base=() _seq_now=() _seq_done=() _seq_blocked=() _seq_kind=() _seq_needcommit=() _seq_committed=()
for (( _i = 0; _i < _n_roles; _i++ )); do
  _seq_base[$_i]="" _seq_now[$_i]="" _seq_done[$_i]=0 _seq_blocked[$_i]=0
  _seq_kind[$_i]="" _seq_needcommit[$_i]=0 _seq_committed[$_i]=0
done
_need_enter_case() { # 输入框型 TUI 需显式 Enter 提交 brief? (herdr 升级后全 kind 均只在框内 paste 不提交, 恒需 Enter)
  printf '1'
}
_i=0
for _n in "${_seq_names[@]}"; do
  _seq_base[$_i]="$(herdr agent get "$_n" 2>/dev/null | jq -r '.result.agent.state_change_seq // ""' 2>/dev/null || true)"
  _seq_kind[$_i]="$(herdr agent get "$_n" 2>/dev/null | jq -r '.result.agent.agent // ""' 2>/dev/null || true)"
  _seq_needcommit[$_i]="$(_need_enter_case "${_seq_kind[$_i]}")"
  _i=$((_i + 1))
done
_pids=()
_i=0
for _n in "${_seq_names[@]}"; do
  herdr agent prompt "$_n" "$(_brief "${_seq_roles[$_i]}" "$_n")" >/dev/null 2>&1 &
  _pids[$_i]=$!
  _i=$((_i + 1))
done
_i=0
for _n in "${_seq_names[@]}"; do
  wait "${_pids[$_i]}" || echo "coherd: WARN: brief 投递 $_n 失败" >&2
  _i=$((_i + 1))
done
for _round in 1 2; do
  sleep "$BRIEF_GRACE"
  _all_done=1
  for (( _i = 0; _i < _n_roles; _i++ )); do
    [ "${_seq_done[$_i]:-0}" = 1 ] && continue
    _n="${_seq_names[$_i]}"
    _seq_now[$_i]="$(herdr agent get "$_n" 2>/dev/null | jq -r '.result.agent.state_change_seq // ""' 2>/dev/null || true)"
    # 输入框型 TUI (herdr 升级后全 kind): seq 涨=文本到达输入框, 非消费。先显式 Enter 提交, 再以 Enter 后 seq 涨确认真消费
    if [ "${_seq_needcommit[$_i]:-0}" = 1 ]; then
      if [ "${_seq_committed[$_i]:-0}" = 0 ]; then
        # 第一轮: 文本已滞在输入框(≥1×BRIEF_GRACE), 发一次 Enter 提交(不重发 brief, 防双处理)
        herdr agent send-keys "$_n" enter >/dev/null 2>&1 || true
        _seq_committed[$_i]=1
        _all_done=0
        continue
      fi
      # 第二轮: Enter 已发 → 文本必已提交; seq 较基线有涨即视为消费完成
      if [ -n "${_seq_now[$_i]:-}" ] && [ "${_seq_now[$_i]:-}" != "${_seq_base[$_i]:-}" ]; then
        _seq_done[$_i]=1
      else
        # 未涨: 判别 blocked 二次确认 (阶段6 已拦截, 此处防误; blocked 不再补 enter)
        _st_blocked="$(herdr agent get "$_n" 2>/dev/null | jq -r '.result.agent.agent_status == "blocked"' 2>/dev/null || true)"
        if [ "$_st_blocked" = "true" ]; then
          _seq_blocked[$_i]=1
        fi
        _all_done=0
      fi
      continue
    fi
  done
  [ "$_all_done" = 1 ] && break
done
# 2 轮宽限后仍未消费 → WARN 不 die (静默/健谈 cluster 可能不涨 seq = 软信号, 误 die 反伤)
for (( _i = 0; _i < _n_roles; _i++ )); do
  [ "${_seq_done[$_i]:-0}" = 1 ] && continue
  _n="${_seq_names[$_i]}"
  if [ "${_seq_blocked[$_i]:-0}" = 1 ]; then
    echo "coherd: WARN: brief 疑似未消费(角色 blocked) $_n — 手动检查 pane" >&2
  else
    echo "coherd: WARN: brief 疑似未消费 $_n — 手动检查 pane" >&2
  fi
done
unset _n _i _n_roles _round _all_done _st_blocked _seq_roles _seq_names _seq_base _seq_now _seq_done _seq_blocked _seq_kind _seq_needcommit _seq_committed _need_enter_case _pids _brief _role_doc

if [ "$SIMPLE" = 1 ]; then
  info "集群就绪: workspace=$WS  simple=两角色  lead=$LEAD_PANE  dev=$DEV_PANE  (契约见 $CONTRACT + lead.md/dev.md)"
elif [ "$TABS" = 1 ]; then
  info "集群就绪: workspace=$WS  tabs=coord:$COORD_PANE rev:$REV_PANE exec:$EXEC_PANE  libero=$LIBERO_PANE(手动, 不 spawn)  (契约见 $CONTRACT + per-role)"
else
  info "集群就绪: workspace=$WS  coordinator=$COORD_PANE  reviewer=$REV_PANE  executor=$EXEC_PANE  (契约见 $CONTRACT + per-role; 依赖 herdr ≥ 需支持上述 pane/agent 操作)"
fi
